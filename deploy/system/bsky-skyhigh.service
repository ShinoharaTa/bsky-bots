# skyhigh（フォロワーの前日投稿数ランキング）を 1 日 1 回実行する。
#
# OS の systemd（/etc/systemd/system/）に置く。設置とロールバックの手順は docs/deploy.md。
# timer から起動する前提なので [Install] は持たない（enable するのは timer だけ）。
[Unit]
Description=Bluesky bot skyhigh (daily follower post ranking)
Documentation=https://github.com/ShinoharaTa/bsky-bots/blob/main/docs/deploy.md
Wants=network-online.target
After=network-online.target
# 失敗を Bluesky への投稿に依存せず journal と Discord に知らせる（#12）。
OnFailure=bsky-bots-failure@%n.service

[Service]
Type=oneshot
# root で動かさない。ログイン不可のシステムユーザー（docs/deploy.md 3-B）。
User=bsky-bots
Group=bsky-bots
# タグを checkout してビルドしたもの（docs/deploy.md 4-1）。
WorkingDirectory=/opt/bsky-bots
# 認証情報（root:bsky-bots 0640）。中身は .env.sample を参照。
EnvironmentFile=/etc/bsky-bots/bsky-bots.env
ExecStart=/usr/bin/node dist/main.js skyhigh --live
# 未設定だと既定の 90 秒（DefaultTimeoutStartSec）で SIGTERM される。
# 実測: 新実装のフル dry-run 349.7〜406.8 秒。余裕を見て 30 分。
TimeoutStartSec=1800
# 実行中にファイルを書かない（src に writeFile 等が無いことを確認済み）ので強めに絞る。
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
