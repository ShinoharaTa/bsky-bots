# bsky-bots の環境変数の一覧（Coolify 版のスケジューラ dist/scheduler/main.js と各 Bot）。
# 名前と説明だけを書く。値は空か既定値。実際の値は Coolify の Environment Variables に入れる。
# 秘密（*_APP_PASSWORD・DISCORD_WEBHOOK_URL）はユーザーが Coolify の画面で入れる。詳細は DEPLOYMENT.md。

# --- 動作モード ---
# dry-run（既定）/ live。live のときだけ子に --live を付けて投稿する。それ以外の値は起動しない
BOT_MODE=dry-run
# 有効にするジョブ（skyhigh,skylog,jiho のカンマ区切り）。空なら何も登録せず待機する。未知の名前は起動しない
BOT_JOBS=

# --- 状態・ラベル ---
# 状態ファイルの置き場所（<STATE_DIR>/scheduler-state.json）。Coolify の Volume を /data にマウントする
STATE_DIR=/data
# ログと Discord に出す名前
SERVICE_NAME=bsky-bots
# ラベル用。live の判定には使わない
APP_ENV=production

# --- ログ ---
# text（既定）/ json。json のときはすべての行を stdout に 1 行 1 JSON で出す
LOG_FORMAT=text
# debug / info（既定）/ warn。スケジューラ自身の行にだけ効く（Bot の出力は落とさない）
LOG_LEVEL=info

# --- 失敗通知（任意） ---
# 秘密。skyhigh / skylog の失敗を Discord に送る。未設定なら起動時に WARN を 1 回出すだけ
DISCORD_WEBHOOK_URL=
# true のときだけ、dry-run でも Discord に送る
NOTIFY_IN_DRY_RUN=false

# --- 認証情報（BOT_MODE=live のとき、有効なジョブの分が必須） ---
# *_IDENTIFIER はハンドル（dry-run では skyhigh / skylog のフォロワー取得の対象にも使う。未設定なら既定のハンドル）
# *_APP_PASSWORD は秘密（App Password）
SKYHIGH_IDENTIFIER=
SKYHIGH_APP_PASSWORD=
SKYLOG_IDENTIFIER=
SKYLOG_APP_PASSWORD=
JIHO_IDENTIFIER=
JIHO_APP_PASSWORD=

# --- テスト用の上書き（dry-run でだけ使う。BOT_MODE=live で 1 つでも設定されていたら起動しない） ---
# <BOT> は SKYHIGH / SKYLOG / JIHO。cron は Asia/Tokyo で読む。JITTER / TIMEOUT は秒
# JOB_CRON_JIHO=
# JOB_JITTER_JIHO=
# JOB_TIMEOUT_JIHO=

# --- その他 ---
# Coolify に設定済み。スケジューラはこれに頼らず、cron を常に Asia/Tokyo で読む
TZ=Asia/Tokyo
